{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "buildCommand": "echo 'App ready'",
      "bindings": [
        {
          "type": "service",
          "service": "legacy",
          "format": "url",
          "env": "LEGACY_URL"
        }
      ]
    },
    "legacy": {
      "root": "_legacy",
      "runtime": "node",
      "buildCommand": "echo 'Legacy ready'"
    }
  },
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/design/prototypes/",
      "permanent": false
    },
    {
      "source": "/design/prototypes/project-types",
      "destination": "/design/prototypes/#projects",
      "permanent": false
    },
    {
      "source": "/design/prototypes/project-types/",
      "destination": "/design/prototypes/#projects",
      "permanent": false
    },
    {
      "source": "/design/prototypes/services",
      "destination": "/design/prototypes/#services",
      "permanent": false
    },
    {
      "source": "/design/prototypes/services/",
      "destination": "/design/prototypes/#services",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/design/assets/:path*",
      "destination": "/design/prototypes/assets/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/design/prototypes/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
