{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static site ready'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/design/prototypes/",
      "permanent": false
    },
    {
      "source": "/legacy",
      "destination": "/_legacy/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/design/assets/:path*",
      "destination": "/design/prototypes/assets/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/design/prototypes/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
